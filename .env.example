# Required SQLAlchemy connection URLs.
# Replace every placeholder locally. Do not use production credentials in this example file.
SOURCE_DATABASE_URL=mariadb+mariadbconnector://<username>:<password>@<host>:3306/<database>
TARGET_DATABASE_URL=postgresql+psycopg2://<username>:<password>@localhost:5432/<database>

# Optional Metabase integration. Leave blank to skip schema synchronization.
METABASE_URL=http://localhost:3000
METABASE_USERNAME=
METABASE_PASSWORD=
METABASE_DATABASE_ID=1

# 0 runs the ETL once. A positive integer enables recurring execution in minutes.
ETL_INTERVAL_MINUTES=0

LOG_LEVEL=INFO
