# Required SQLAlchemy connection URLs. Replace placeholders locally.
SOURCE_DATABASE_URL=mariadb+mariadbconnector://<username>:<password>@<host>:3306/<database>
TARGET_DATABASE_URL=postgresql+psycopg2://<username>:<password>@localhost:5432/<database>

# Optional Metabase integration; leave blank to skip synchronization.
METABASE_URL=http://localhost:3000
METABASE_USERNAME=
METABASE_PASSWORD=
METABASE_DATABASE_ID=1

# 0 runs once. A positive integer schedules repeated ETL runs in minutes.
ETL_INTERVAL_MINUTES=0
LOG_LEVEL=INFO
